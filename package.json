{
  "name": "@naevic/agent-memoize",
  "version": "0.1.0",
  "description": "Shared project-memory MCP server for AI coding agents (Claude Code, Codex, ...)",
  "license": "MIT",
  "type": "module",
  "main": "dist/exports.js",
  "types": "dist/exports.d.ts",
  "exports": {
    ".": {
      "types": "./dist/exports.d.ts",
      "default": "./dist/exports.js"
    },
    "./package.json": "./package.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "agent-memoize": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && npm run build -w @naevic/agent-memoize-plugin-log-observer",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepublishOnly": "npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "picomatch": "^4.0.5",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
